default:
    @just --list

verify:
    cargo verus verify -p vericache-transfer-core

audit:
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-assume-admit-truncate.yml src
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-external-escape.yml src
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-external-body.yml --globs '!src/{context,transport}/ffi.rs' src
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-unsafe.yml --globs '!src/{context,transport}/ffi.rs' src
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-unverified-code.yml --globs '!src/{context,transport}/ffi.rs' src
    ast-grep scan --custom-languages allow -c ../sgconfig.yml -r ../rules/no-panicking-stubs.yml src

fmt:
    find src -name '*.rs' -exec verusfmt {} +

fmt-check:
    find src -name '*.rs' -exec verusfmt --check {} +

check: verify audit fmt-check

test:
    cargo test -p vericache-transfer-core
