FROM nvcr.io/nvidia/cuda:13.0.2-devel-ubuntu24.04

ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/vericache/rustup \
    CARGO_HOME=/opt/vericache/cargo \
    VERUS_Z3_PATH=/opt/vericache/z3/bin/z3 \
    VERUS_CVC5_PATH=/opt/vericache/cvc5/bin/cvc5 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/opt/vericache/bin:/opt/vericache/verus/bin:/opt/vericache/z3/bin:/opt/vericache/cvc5/bin:/opt/vericache/cargo/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN nvcc --version \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git pkg-config python3 unzip xz-utils \
        ibverbs-providers ibverbs-utils libibverbs-dev sudo \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash dev \
    && printf '%s\n' \
        'Defaults:dev secure_path="/opt/vericache/bin:/opt/vericache/verus/bin:/opt/vericache/z3/bin:/opt/vericache/cvc5/bin:/opt/vericache/cargo/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' \
        'dev ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && visudo -cf /etc/sudoers

COPY artifacts.env install-toolchains.sh /opt/vericache/image/
RUN chmod +x /opt/vericache/image/install-toolchains.sh \
    && bash /opt/vericache/image/install-toolchains.sh

WORKDIR /workspace
CMD ["bash"]
